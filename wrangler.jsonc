{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ravenswatch-randomizer",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
  },
  "routes": [
    { "pattern": "ravenswatch-randomizer.com", "custom_domain": true },
    { "pattern": "www.ravenswatch-randomizer.com", "custom_domain": true },
  ],
  // Served only on the custom domains, so search engines see one copy of the site
  "workers_dev": false,
  "preview_urls": true,
}
